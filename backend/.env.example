# Database configuration
# For local SQLite fallback (default):
DATABASE_URL=sqlite:///./scamshield.db
# For PostgreSQL (local or hosted like Supabase, Neon, AWS RDS, Render):
# DATABASE_URL=postgresql://user:password@localhost:5432/scamshield_db

# Security & Authentication
# Generate a strong 64-character secret key with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-replace-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
ENVIRONMENT=development

# CORS settings
FRONTEND_ORIGIN=http://localhost:5173

# Optional Groq AI Integration (leave blank to use pure explainable rule engine)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
